---
import Icon from './Icon.astro';

interface Props {
  model: string;
  steps: string[];
  tip?: string;
}
const { model, steps, tip } = Astro.props;
---
<section class="solution-steps">
  <h3 class="ss-title"><Icon name="compass" size={16} /> {model}</h3>
  <ol class="ss-list">
    {steps.map((s) => <li>{s}</li>)}
  </ol>
  {tip && <p class="ss-tip"><Icon name="lightbulb" size={16} /> {tip}</p>}
</section>
