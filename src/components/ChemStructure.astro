---
interface Props {
  smiles: string;
  caption?: string;
  height?: string;
  alt?: string;
}
const { smiles, caption, height = '200px', alt } = Astro.props;
const label = alt ?? caption ?? '化学结构式';
---
<figure class="chem-figure">
  <div
    class="chem-canvas"
    data-smiles={smiles}
    style={`min-height:${height}`}
    role="img"
    aria-label={label}
  >
  </div>
  {caption && <figcaption class="chem-caption">{caption}</figcaption>}
  <noscript><p class="chem-caption">结构式需要启用 JavaScript 后渲染。</p></noscript>
</figure>
<script>
  import SmilesDrawer from 'smiles-drawer';

  interface DrawerLike {
    draw(tree: unknown, target: SVGSVGElement, theme: string): SVGSVGElement;
  }

  function currentTheme(): 'dark' | 'light' {
    return document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
  }

  // ACS Document 1996 结构式风格：单色（随站点亮/暗主题自适应）、Helvetica 系字体、略粗的键。
  // smiles-drawer 本身以骨架式绘制（自动隐碳标签、显杂原子），故不改动氢的显示以免误表示结构。
  const ACS_ELEMENTS = ['C', 'O', 'N', 'F', 'CL', 'BR', 'I', 'P', 'S', 'B', 'SI', 'H'];
  function monoTheme(foreground: string): Record<string, string> {
    const theme: Record<string, string> = { FOREGROUND: foreground, BACKGROUND: 'transparent' };
    for (const el of ACS_ELEMENTS) theme[el] = foreground;
    return theme;
  }
  const ACS_1996_OPTIONS = {
    fontFamily: 'ACSCurrent, ACSDocument, "Helvetica Neue", Helvetica, Arial, sans-serif',
    bondThickness: 1.5,
    bondLength: 30,
    fontSizeLarge: 12,
    themes: {
      dark: monoTheme('#e6e9ee'),
      light: monoTheme('#18202a'),
    },
  };

  // 苯环内圈：smiles-drawer 2.4.1 的 drawRing 把半径硬算成 apothem(bondLength) − bondSpacing
  // （bondLength=30 时约 20.9，直径占六边形对角距 69.6%，偏大），且该版本已移除 aromaticCircles
  // 选项，没有官方旋钮，只能在画完后改写。半径按「内切半径的占比」给值，bondLength 变化时比例不变。
  // AROMATIC_RING_FILL=0.6 → r≈15.6，直径/对角距≈52%，单侧间隙≈10.4。
  const AROMATIC_RING_FILL = 0.6;

  function tuneAromaticRing(svg: SVGSVGElement): void {
    const apothem = ACS_1996_OPTIONS.bondLength * Math.cos(Math.PI / 6);
    // 全库只有 drawRing 给圆设 fill="none"；楔形键与原子标签遮罩的圆都是实心，不会命中。
    svg.querySelectorAll<SVGCircleElement>('circle[fill="none"]').forEach((circle) => {
      const current = Number.parseFloat(circle.getAttribute('r') ?? '');
      // 半径超出六边形范围说明这已经不是芳香环圆圈（升级后语义变化），宁可不动。
      if (!Number.isFinite(current) || current <= 0 || current > apothem) {
        console.warn('[ChemStructure] 圆圈半径异常，未改写：', circle.getAttribute('r'));
        return;
      }
      circle.setAttribute('r', (apothem * AROMATIC_RING_FILL).toFixed(2));
    });
  }

  function renderFallback(el: HTMLElement, smiles: string): void {
    el.replaceChildren();
    const code = document.createElement('code');
    code.className = 'chem-fallback';
    code.textContent = smiles;
    const tip = document.createElement('p');
    tip.className = 'chem-caption';
    tip.textContent = '结构渲染失败，以上为原始 SMILES。';
    el.append(code, tip);
  }

  function ensureSvg(el: HTMLElement, width: number, height: number): SVGSVGElement {
    const existing = el.querySelector<SVGSVGElement>('svg.chem-svg');
    if (existing) return existing;
    const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
    svg.setAttribute('class', 'chem-svg');
    svg.setAttribute('width', String(width));
    svg.setAttribute('height', String(height));
    svg.setAttribute('viewBox', `0 0 ${width} ${height}`);
    el.replaceChildren(svg);
    return svg;
  }

  function render(el: HTMLElement): void {
    const smiles = el.dataset.smiles ?? '';
    if (!smiles) return;
    const styles = getComputedStyle(el);
    const width = Math.max(el.clientWidth, 240);
    const height = Math.max(parseInt(styles.minHeight, 10) || 200, 120);
    try {
      const drawer = new SmilesDrawer.SvgDrawer({
        width,
        height,
        padding: 12,
        ...ACS_1996_OPTIONS,
      }) as unknown as DrawerLike;
      SmilesDrawer.parse(
        smiles,
        (tree: unknown) => {
          const svg = ensureSvg(el, width, height);
          svg.replaceChildren();
          const drawn = drawer.draw(tree, svg, currentTheme());
          const target = (drawn ?? svg) as SVGSVGElement;
          if (target !== svg) el.replaceChildren(target);
          target.setAttribute('width', String(width));
          target.setAttribute('height', String(height));
          if (!target.getAttribute('viewBox')) {
            target.setAttribute('viewBox', `0 0 ${width} ${height}`);
          }
          // 每次重绘（含切换主题）都要重新改写，否则内圈会弹回 drawRing 的默认值
          tuneAromaticRing(target);
        },
        (e: unknown) => {
          console.error('[ChemStructure] SMILES 解析失败:', smiles, e);
          renderFallback(el, smiles);
        },
      );
    } catch (err) {
      console.error('[ChemStructure] 渲染失败:', smiles, err);
      renderFallback(el, smiles);
    }
  }

  function renderAll(): void {
    document.querySelectorAll<HTMLElement>('.chem-canvas').forEach(render);
  }

  function init(): void {
    renderAll();
    new MutationObserver(renderAll).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });
  }

  if (document.readyState !== 'loading') init();
  else document.addEventListener('DOMContentLoaded', init);
</script>
