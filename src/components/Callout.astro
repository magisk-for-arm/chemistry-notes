---
import Icon from './Icon.astro';
import type { IconName } from '@/utils/icons';

type CalloutType =
  | 'wrong'
  | 'why'
  | 'right'
  | 'skill'
  | 'tip'
  | 'note'
  | 'memory'
  | 'formula';

interface Props {
  type?: CalloutType;
  title?: string;
}
const { type = 'note', title } = Astro.props;
const icons: Record<CalloutType, IconName> = {
  wrong: 'circle-x',
  why: 'search',
  right: 'circle-check',
  skill: 'target',
  tip: 'lightbulb',
  note: 'pin',
  memory: 'brain',
  formula: 'calculator',
};
const labels: Record<CalloutType, string> = {
  wrong: '错误示例',
  why: '错因剖析',
  right: '正确做法',
  skill: '接题方法',
  tip: '技巧',
  note: '注意',
  memory: '记忆',
  formula: '公式',
};
---
<div class:list={['callout', `callout-${type}`]}>
  <div class="callout-head"><Icon name={icons[type]} size={16} /><span>{title ?? labels[type]}</span></div>
  <div class="callout-body prose"><slot /></div>
</div>
