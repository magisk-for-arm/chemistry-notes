---
import Icon from './Icon.astro';
import type { IconName } from '@/utils/icons';
import { withBase } from '@/utils/links';

interface NavItem {
  key: string;
  label: string;
  icon: IconName;
  href: string;
}
interface TopicItem {
  slug: string;
  title: string;
  icon: IconName;
}
interface Props {
  subject: string;
  topic: string;
  topicList: TopicItem[];
  navSections: NavItem[];
  current: string;
}
const { subject, topic, topicList, navSections, current } = Astro.props;
---
<aside class="sidebar" id="knowledge-sidebar">
  <div class="sidebar-block">
    <p class="sidebar-title">知识点</p>
    <ul class="sidebar-list">
      {
        topicList.map((t) => (
          <li>
            <a href={withBase(`/${subject}/${t.slug}`)} class:list={[{ active: t.slug === topic }]}>
              <span><Icon name={t.icon} size={16} /></span>
              <span>{t.title}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  <div class="sidebar-block">
    <p class="sidebar-title">本页专题</p>
    <ul class="sidebar-list">
      {
        navSections.map((s) => (
          <li>
            <a href={s.href} class:list={[{ active: s.key === current }]}>
              <span><Icon name={s.icon} size={16} /></span>
              <span>{s.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</aside>
